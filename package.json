{
  "name": "opening-page-generator",
  "version": "1.21.0",
  "private": true,
  "description": "企鹅的酒馆开场页生成器 —— 多文件源码 + 单文件构建产物",
  "type": "commonjs",
  "scripts": {
    "build": "node build.js",
    "build:ext": "npm run build && node ext-build.js",
    "postbuild": "node scripts/smoke-static.mjs",
    "watch": "node build.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-static.mjs && node scripts/smoke-browser.mjs",
    "lint": "node lint.js",
    "nh": "node scripts/nh-import.mjs",
    "nh-serve": "node scripts/nh-import.mjs --serve",
    "nh-install": "node scripts/nh-install.mjs",
    "nh-uninstall": "node scripts/nh-install.mjs uninstall",
    "pack:helper": "node scripts/pack-helper.mjs"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "vitest": "^4.1.11"
  }
}
